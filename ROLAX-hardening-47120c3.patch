new file mode 100644
index 0000000..d53e404
--- /dev/null
+++ b/lib/rate-limit.ts
@@ -0,0 +1,22 @@
+import "server-only";
+import type { NextRequest } from "next/server";
+
+const buckets = new Map<string, { count: number; resetAt: number }>();
+
+export function requestKey(req: NextRequest) {
+  return String(req.headers.get("x-forwarded-for") || req.headers.get("x-real-ip") || "unknown")
+    .split(",")[0].trim().slice(0, 100);
+}
+
+/** Best-effort per-function burst limiter; put a durable edge limiter in front for global enforcement. */
+export function rateLimit(req: NextRequest, namespace: string, limit: number, windowMs: number) {
+  const now = Date.now();
+  const key = `${namespace}:${requestKey(req)}`;
+  const current = buckets.get(key);
+  if (!current || current.resetAt <= now) {
+    buckets.set(key, { count: 1, resetAt: now + windowMs });
+    return { limited: false, retryAfter: Math.ceil(windowMs / 1000) };
+  }
+  current.count += 1;
+  return { limited: current.count > limit, retryAfter: Math.ceil(Math.max(0, current.resetAt - now) / 1000) };
+}
