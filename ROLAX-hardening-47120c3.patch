diff --git a/components/OpenGraphSync.tsx b/components/OpenGraphSync.tsx
new file mode 100644
index 0000000..cdb03b1
--- /dev/null
+++ b/components/OpenGraphSync.tsx
@@ -0,0 +1,31 @@
+"use client";
+
+import { useEffect } from "react";
+import { useStore } from "@/lib/store";
+
+/**
+ * Keeps the social-preview image in sync with the image selected in the
+ * admin customizer for the current browser. Crawlers still get the
+ * production-safe default from app/layout.tsx.
+ */
+export default function OpenGraphSync() {
+  const ogImageUrl = useStore((state) => state.settings.ogImageUrl);
+  const hydrate = useStore((state) => state.hydrate);
+
+  useEffect(() => {
+    hydrate();
+  }, [hydrate]);
+
+  useEffect(() => {
+    if (!ogImageUrl || typeof document === "undefined") return;
+    const resolved = ogImageUrl.startsWith("data:") || /^https?:\/\//i.test(ogImageUrl)
+      ? ogImageUrl
+      : new URL(ogImageUrl, window.location.origin).href;
+
+    document
+      .querySelectorAll('meta[property="og:image"], meta[name="twitter:image"]')
+      .forEach((tag) => tag.setAttribute("content", resolved));
+  }, [ogImageUrl]);
+
+  return null;
+}
