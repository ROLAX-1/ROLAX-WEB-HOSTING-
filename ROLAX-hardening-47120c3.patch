+    if not value:
+        return True
+    if value in _WEBHOOK_PROCESSED_UPDATE_IDS:
+        return False
+    _WEBHOOK_PROCESSED_UPDATE_IDS.append(value)
+    _WEBHOOK_PROCESSED_UPDATE_IDS = _WEBHOOK_PROCESSED_UPDATE_IDS[-_WEBHOOK_PROCESSED_UPDATE_LIMIT:]
+    return True
