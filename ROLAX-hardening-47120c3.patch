+def normalize_ai_key_input(provider: str, value: str) -> str:
+    """Accept a pasted raw key or KEY=value without storing wrappers.
+
+    Telegram users commonly paste ``ANTHROPIC_API_KEY=sk-ant-...`` or a
+    Markdown/code-formatted value. The previous flow stored that whole line,
+    so Anthropic rejected it even though the key itself was valid.
+    """
+    raw = str(value or "").strip()
+    if raw.startswith("```") and raw.endswith("```"):
+        raw = raw[3:-3].strip()
+        lines = raw.splitlines()
+        if lines and lines[0].strip().lower() in {"text", "bash", "shell", "sh", "env", "dotenv"}:
+            raw = "\n".join(lines[1:]).strip()
+    allowed_names = {
+        "gemini": "GEMINI_API_KEY",
+        "groq": "GROQ_API_KEY",
+        "openai": "OPENAI_API_KEY",
+        "anthropic": "ANTHROPIC_API_KEY",
+        "custom": "CUSTOM_AI_API_KEY",
+    }
+    expected = allowed_names.get(str(provider or "").strip().lower(), "")
+    if "=" in raw:
+        left, right = raw.split("=", 1)
+        left = left.strip()
+        if left.lower().startswith("export "):
+            left = left[7:].strip()
+        if left.upper() in {expected, "API_KEY", "KEY"}:
+            raw = right.strip()
+    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in {"`", '"', "'"}:
+        raw = raw[1:-1].strip()
+    return "".join(raw.split())
+
+
+def validate_ai_key_input(provider: str, value: str) -> str:
+    """Return a safe, user-facing validation error, or an empty string."""
+    key = str(value or "")
+    if not key:
+        return "API key empty hai. Raw key, KEY=value, ya fenced key bhejo."
+    if len(key) < 10:
+        return "API key bahut chhoti hai. Valid provider key bhejo ya /cancel."
+    if len(key) > 500:
+        return "API key bahut lambi hai. Sirf key bhejo, poora document nahi."
+    if any(ord(char) < 33 or ord(char) > 126 for char in key):
+        return "API key me invalid characters hain. Key ko ek hi line me bhejo."
+    if "=" in key:
+        return "API key wrapper remove nahi hua. Raw key ya PROVIDER_API_KEY=value format bhejo."
+    if str(provider or "").strip().lower() == "anthropic" and not key.startswith("sk-ant-"):
+        return "Claude/Anthropic key ka format valid nahi lag raha. Key aam taur par sk-ant- se start hoti hai."
+    return ""
+
