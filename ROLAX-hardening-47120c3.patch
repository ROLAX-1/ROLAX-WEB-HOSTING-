diff --git a/middleware.ts b/middleware.ts
new file mode 100644
index 0000000..f8bc654
--- /dev/null
+++ b/middleware.ts
@@ -0,0 +1,35 @@
+import { NextRequest, NextResponse } from "next/server";
+
+const NOT_FOUND_HEADERS = {
+  "cache-control": "no-store",
+  "x-content-type-options": "nosniff",
+  "x-robots-tag": "noindex, noarchive, nosnippet",
+};
+
+const blockedPath = [
+  /^\/(?:\.git|\.env(?:\.|\/|$)|\.vercel(?:\/|$)|\.next(?:\/|$)|src(?:\/|$)|app(?:\/|$)|lib(?:\/|$)|components(?:\/|$)|hosted(?:\/|$)|serverless-functions(?:\/|$)|out(?:\/|$)|uploads(?:\/|$))/i,
+  /(?:^|\/)(?:[^/]+\.(?:bak|old|orig|save|swp|swo|tmp|map))(?:$|\?)/i,
+  /(?:^|\/)(?:bootstrap(?:-[^/]+)?\.js|package-lock\.json|next\.config\.[^/]+|tsconfig\.json)(?:$|\?)/i,
+  /\.(?:py|tsx?|jsx?|mjs|cjs|prisma|sql)$/i,
+];
+
+function shouldBlock(pathname: string) {
+  // This fixed health response is a hosting compatibility endpoint; it never
+  // serves Python/source content. All other serverless-function paths stay 404.
+  if (pathname === "/serverless-functions/rolax_webhook.py") return false;
+  if (pathname.startsWith("/_next/static/") && pathname.endsWith(".map")) return true;
+  return blockedPath.some(pattern => pattern.test(pathname));
+}
+
+export function middleware(req: NextRequest) {
+  const pathname = req.nextUrl.pathname;
+  if (shouldBlock(pathname)) return new NextResponse(null, { status: 404, headers: NOT_FOUND_HEADERS });
+
+  const response = NextResponse.next();
+  if (/^\/(?:admin|dashboard|api|run)(?:\/|$)/i.test(pathname)) {
+    response.headers.set("x-robots-tag", "noindex, noarchive, nosnippet");
+  }
+  return response;
+}
+
+export const config = { matcher: ["/:path*"] };
