+  const admin = adminFromRequest(req);
+  if (admin) {
+    return NextResponse.json(
+      { ok: true, authenticated: true, user: { id: "admin", name: "ROLAX Admin", email: admin.email, isAdmin: true, role: admin.role } },
+      { headers: { "cache-control": "no-store" } },
+    );
+  }
+  const user = userFromRequest(req);
+  if (!user || user.sub !== "user") return unauthorized("Login required");
+  return NextResponse.json(
+    { ok: true, authenticated: true, user: { id: user.id, name: user.name, email: user.email, isAdmin: false } },
+    { headers: { "cache-control": "no-store" } },
+  );
+}
