diff --git a/supabase/functions/api/index.ts b/supabase/functions/api/index.ts
new file mode 100644
index 0000000..62d2289
--- /dev/null
+++ b/supabase/functions/api/index.ts
@@ -0,0 +1,103 @@
+const LEGACY_WEBHOOK = "https://rolax-web-hosting.vercel.app/api/rolax_webhook";
+const memoryClaims = new Map<string, number>();
+const MEMORY_LIMIT = 256;
+const MEMORY_TTL = 10 * 60 * 1000;
+
+function json(value: unknown, status = 200) {
+  return new Response(JSON.stringify(value), {
+    status,
+    headers: { "content-type": "application/json; charset=utf-8" },
+  });
+}
+
+function sameSecret(actual: string, expected: string) {
+  if (!actual || !expected) return false;
+  let diff = actual.length ^ expected.length;
+  const size = Math.max(actual.length, expected.length);
+  for (let i = 0; i < size; i += 1) {
+    diff |= (actual.charCodeAt(i) || 0) ^ (expected.charCodeAt(i) || 0);
+  }
+  return diff === 0;
+}
+
+function remember(id: string) {
+  const now = Date.now();
+  for (const [key, at] of memoryClaims) {
+    if (now - at > MEMORY_TTL) memoryClaims.delete(key);
+  }
+  if (memoryClaims.has(id)) return false;
+  memoryClaims.set(id, now);
+  while (memoryClaims.size > MEMORY_LIMIT) {
+    const first = memoryClaims.keys().next().value;
+    if (first) memoryClaims.delete(first);
+    else break;
+  }
+  return true;
+}
+
+async function durableClaim(updateId: string) {
+  const base = Deno.env.get("SUPABASE_URL") || "";
+  const key = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") || Deno.env.get("SUPABASE_ANON_KEY") || "";
+  if (!base || !key) return true;
+  try {
+    const response = await fetch(`${base}/rest/v1/rolax_webhook_claims?on_conflict=update_id`, {
+      method: "POST",
+      headers: {
+        apikey: key,
+        Authorization: `Bearer ${key}`,
+        "content-type": "application/json",
+        Prefer: "resolution=ignore-duplicates,return=representation",
+      },
+      body: JSON.stringify([{ update_id: updateId }]),
+    });
+    if (!response.ok) return true;
+    const rows = await response.json().catch(() => []);
+    return Array.isArray(rows) && rows.length > 0;
+  } catch {
+    return true;
+  }
+}
+
+async function forward(raw: string, state: string, secret: string) {
+  const target = new URL(LEGACY_WEBHOOK);
+  if (state) target.searchParams.set("state", state);
+  return fetch(target, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      "x-telegram-bot-api-secret-token": secret,
+      "user-agent": "ROLAX-Telegram-Webhook-Guard/1",
+    },
+    body: raw,
+  });
+}
+
+Deno.serve(async (request) => {
+  if (request.method === "GET") return json({ ok: true, service: "ROLAX Telegram webhook guard" });
+  if (request.method !== "POST") return json({ ok: false, error: "method_not_allowed" }, 405);
+
+  const secret = request.headers.get("x-telegram-bot-api-secret-token") || "";
+  const expectedSecret = Deno.env.get("ROLAX_WEBHOOK_SECRET") || "";
+  if (!secret) return json({ ok: false, error: "missing_telegram_secret" }, 401);
+  if (!sameSecret(secret, expectedSecret)) return json({ ok: false, error: "unauthorized" }, 401);
+
+  const raw = await request.text();
+  let update: any;
+  try { update = JSON.parse(raw); } catch { return json({ ok: false, error: "invalid_json" }, 400); }
+  const updateId = update && update.update_id !== undefined ? String(update.update_id) : "";
+  if (updateId) {
+    if (!remember(updateId)) return json({ ok: true, duplicate: true });
+    if (!(await durableClaim(updateId))) return json({ ok: true, duplicate: true });
+  }
+
+  const incoming = new URL(request.url);
+  const state = incoming.searchParams.get("state") || "";
+  const delivery = forward(raw, state, secret).catch(() => undefined);
+  const runtime = (globalThis as any).EdgeRuntime;
+  if (runtime && typeof runtime.waitUntil === "function") {
+    runtime.waitUntil(delivery);
+  } else {
+    await Promise.race([delivery, new Promise(resolve => setTimeout(resolve, 8000))]);
+  }
+  return json({ ok: true, forwarded: true });
+});
