+++ b/app/api/admin/accounts/route.ts
@@ -0,0 +1,141 @@
+import "server-only";
+import { NextRequest, NextResponse } from "next/server";
+import bcrypt from "bcryptjs";
+import { randomUUID } from "node:crypto";
+import {
+  ADMIN_PASSWORD_MIN_LENGTH,
+  ADMIN_ROLES,
+  activeAdminFromRequest,
+  activeAdminHasRole,
+  configuredAdminEmail,
+  forbidden,
+  sameOrigin,
+  unauthorized,
+} from "@/lib/server-auth";
+import { readTelegramState, writeTelegramState } from "@/lib/telegram-state";
+import { rateLimit } from "@/lib/rate-limit";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function noStore(body: any, status = 200) {
+  return NextResponse.json(body, { status, headers: { "cache-control": "no-store" } });
+}
+
+function passwordPolicy(password: string) {
+  if (password.length < ADMIN_PASSWORD_MIN_LENGTH) return "Password must be at least 16 characters";
+  if (password.length > 256 || /\s/.test(password)) return "Password is invalid";
+  if (!/[a-z]/.test(password) || !/[A-Z]/.test(password) || !/[0-9]/.test(password) || !/[^A-Za-z0-9]/.test(password)) {
+    return "Use uppercase, lowercase, number, and symbol";
+  }
+  return "";
+}
+
+function email(value: unknown) {
+  const normalized = String(value || "").trim().toLowerCase();
+  return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(normalized) ? normalized : "";
+}
+
+function publicAccount(row: any) {
+  if (!row || typeof row !== "object") return null;
+  const { passwordHash: _passwordHash, ...safe } = row;
+  return {
+    ...safe,
+    email: String(safe.email || "").toLowerCase(),
+    role: ADMIN_ROLES.includes(safe.role) ? safe.role : "auditor",
+    status: safe.status === "disabled" ? "disabled" : "active",
+    mfa: { ready: true, enabled: Boolean(safe.mfa?.enabled), required: Boolean(safe.mfa?.required), method: safe.mfa?.method === "totp" ? "totp" : undefined },
+  };
+}
+
+function listAccounts(state: any) {
+  const rows = state.admin_accounts && typeof state.admin_accounts === "object" ? Object.values(state.admin_accounts) : [];
+  const result = rows.map(publicAccount).filter(Boolean);
+  const ownerEmail = configuredAdminEmail();
+  if (ownerEmail && !result.some((row: any) => row.email === ownerEmail)) {
+    result.unshift({ id: "admin_owner", email: ownerEmail, name: "ROLAX Owner", role: "owner", status: "active", createdAt: "bootstrap", mfa: { ready: true, enabled: false, required: false } });
+  }
+  return result;
+}
+
+function audit(state: any, actor: string, action: string) {
+  const previous = Array.isArray(state.audit_events) ? state.audit_events : [];
+  return [...previous.slice(-99), { id: randomUUID(), actor, action, at: new Date().toISOString() }];
+}
+
+export async function GET(req: NextRequest) {
+  const admin = await activeAdminFromRequest(req);
+  if (!admin) return unauthorized("Admin session required");
+  if (!(await activeAdminHasRole(req, ["owner", "security_admin"]))) return forbidden("Security-admin role required");
+  const limited = rateLimit(req, "admin-accounts-read", 30, 60_000);
+  if (limited.limited) return noStore({ ok: false, error: "Too many requests" }, 429);
+  const loaded = await readTelegramState(req);
+  if (!loaded.ok) return noStore({ ok: false, error: "Secure admin storage is unavailable" }, 503);
+  return noStore({ ok: true, accounts: listAccounts(loaded.state) });
+}
+
+export async function POST(req: NextRequest) {
+  const admin = await activeAdminFromRequest(req);
+  if (!admin) return unauthorized("Admin session required");
+  if (!(await activeAdminHasRole(req, ["owner"]))) return forbidden("Owner role required");
+  if (!sameOrigin(req)) return noStore({ ok: false, error: "Invalid request origin" }, 403);
+  const limited = rateLimit(req, "admin-accounts-write", 10, 15 * 60 * 1000);
+  if (limited.limited) return noStore({ ok: false, error: "Too many account changes" }, 429);
+
+  let body: any;
+  try { body = await req.json(); } catch { return noStore({ ok: false, error: "Invalid JSON" }, 400); }
+  const targetEmail = email(body.email);
+  const name = String(body.name || targetEmail.split("@")[0] || "Admin").trim().slice(0, 120);
+  const role = String(body.role || "operator");
+  const password = String(body.password || "");
+  if (!targetEmail || !name || !ADMIN_ROLES.includes(role as any) || role === "owner") return noStore({ ok: false, error: "Valid email, name, and non-owner role are required" }, 400);
+  if (targetEmail === configuredAdminEmail()) return noStore({ ok: false, error: "Bootstrap owner email cannot be assigned to another role" }, 409);
+  const policyError = passwordPolicy(password);
+  if (policyError) return noStore({ ok: false, error: policyError }, 400);
+
+  const loaded = await readTelegramState(req);
+  if (!loaded.ok) return noStore({ ok: false, error: "Secure admin storage is unavailable" }, 503);
+  const accounts = loaded.state.admin_accounts && typeof loaded.state.admin_accounts === "object" ? { ...loaded.state.admin_accounts } : {};
+  if (accounts[targetEmail]) return noStore({ ok: false, error: "Admin account already exists" }, 409);
+  const now = new Date().toISOString();
+  const record = {
+    id: `admin_${randomUUID()}`,
+    email: targetEmail,
+    name,
+    role,
+    status: "active" as const,
+    passwordHash: await bcrypt.hash(password, 12),
+    createdAt: now,
+    changedAt: now,
+    mfa: { enabled: false, required: false },
+  };
+  accounts[targetEmail] = record;
+  const saved = await writeTelegramState(req, { ...loaded.state, admin_accounts: accounts, admin_credentials: undefined, audit_events: audit(loaded.state, admin.email, "admin.account.create") }, loaded.webhookUrl);
+  if (!saved.ok) return noStore({ ok: false, error: "Secure admin storage failed" }, 503);
+  return noStore({ ok: true, account: publicAccount(record) }, 201);
+}
+
+export async function PATCH(req: NextRequest) {
+  const admin = await activeAdminFromRequest(req);
+  if (!admin) return unauthorized("Admin session required");
+  if (!(await activeAdminHasRole(req, ["owner"]))) return forbidden("Owner role required");
+  if (!sameOrigin(req)) return noStore({ ok: false, error: "Invalid request origin" }, 403);
+  const limited = rateLimit(req, "admin-accounts-write", 10, 15 * 60 * 1000);
+  if (limited.limited) return noStore({ ok: false, error: "Too many account changes" }, 429);
+  let body: any;
+  try { body = await req.json(); } catch { return noStore({ ok: false, error: "Invalid JSON" }, 400); }
+  const targetEmail = email(body.email);
+  if (!targetEmail || targetEmail === admin.email || targetEmail === configuredAdminEmail()) return noStore({ ok: false, error: "This account cannot be disabled or reassigned here" }, 400);
+
+  const loaded = await readTelegramState(req);
+  if (!loaded.ok) return noStore({ ok: false, error: "Secure admin storage is unavailable" }, 503);
+  const accounts = loaded.state.admin_accounts && typeof loaded.state.admin_accounts === "object" ? { ...loaded.state.admin_accounts } : {};
+  const current = accounts[targetEmail];
+  if (!current) return noStore({ ok: false, error: "Admin account not found" }, 404);
+  const nextRole = body.role === undefined ? current.role : String(body.role);
+  if (!ADMIN_ROLES.includes(nextRole as any) || nextRole === "owner") return noStore({ ok: false, error: "Invalid role" }, 400);
+  accounts[targetEmail] = { ...current, name: body.name === undefined ? current.name : String(body.name).trim().slice(0, 120), role: nextRole, status: body.status === "disabled" ? "disabled" : "active", changedAt: new Date().toISOString() };
+  const saved = await writeTelegramState(req, { ...loaded.state, admin_accounts: accounts, audit_events: audit(loaded.state, admin.email, `admin.account.update:${nextRole}`) }, loaded.webhookUrl);
+  if (!saved.ok) return noStore({ ok: false, error: "Secure admin storage failed" }, 503);
+  return noStore({ ok: true, account: publicAccount(accounts[targetEmail]) });
+}
