diff --git a/lib/server-auth.ts b/lib/server-auth.ts
new file mode 100644
index 0000000..bf086e1
--- /dev/null
+++ b/lib/server-auth.ts
@@ -0,0 +1,260 @@
+import "server-only";
+import { NextRequest, NextResponse } from "next/server";
+import bcrypt from "bcryptjs";
+import jwt, { type JwtPayload } from "jsonwebtoken";
+import { readTelegramState } from "@/lib/telegram-state";
+
+export const ADMIN_COOKIE = "rolax_admin_session";
+export const USER_COOKIE = "rolax_user_session";
+export const ADMIN_PASSWORD_MIN_LENGTH = 16;
+const SESSION_TTL_SECONDS = 2 * 60 * 60;
+
+export type AdminRole = "owner" | "security_admin" | "operator" | "support" | "auditor";
+export const ADMIN_ROLES: AdminRole[] = ["owner", "security_admin", "operator", "support", "auditor"];
+
+export type AdminAccount = {
+  id: string;
+  email: string;
+  name: string;
+  role: AdminRole;
+  status: "active" | "disabled";
+  createdAt: string;
+  changedAt?: string;
+  lastLoginAt?: string;
+  mfa: { ready: true; enabled: boolean; required: boolean; method?: "totp" };
+};
+
+type AdminAccountRecord = AdminAccount & { passwordHash: string };
+
+type AdminClaims = JwtPayload & {
+  sub: "admin";
+  email: string;
+  role: AdminRole;
+  authLevel: "password";
+  mfa: "ready" | "not-enrolled";
+};
+
+type UserClaims = JwtPayload & {
+  sub: "user";
+  id: string;
+  email: string;
+  name: string;
+  isAdmin: false;
+};
+
+function authSecret() {
+  return String(process.env.ROLAX_ADMIN_SESSION_SECRET || "").trim();
+}
+
+export function configuredAdminEmail() {
+  return String(process.env.ROLAX_ADMIN_EMAIL || "").trim().toLowerCase();
+}
+
+function validHash(value: unknown): value is string {
+  return typeof value === "string" && /^\$2[aby]?\$\d{2}\$/.test(value.trim());
+}
+
+function validRole(value: unknown): value is AdminRole {
+  return typeof value === "string" && ADMIN_ROLES.includes(value as AdminRole);
+}
+
+function safeAccount(record: any, fallback?: Partial<AdminAccountRecord>): AdminAccountRecord | null {
+  const email = String(record?.email || fallback?.email || "").trim().toLowerCase();
+  const passwordHash = String(record?.passwordHash || fallback?.passwordHash || "").trim();
+  if (!email || !validHash(passwordHash)) return null;
+  const role = validRole(record?.role) ? record.role : validRole(fallback?.role) ? fallback.role : "owner";
+  return {
+    id: String(record?.id || fallback?.id || `admin_${email}`).slice(0, 120),
+    email,
+    name: String(record?.name || fallback?.name || "ROLAX Admin").slice(0, 120),
+    role,
+    status: record?.status === "disabled" ? "disabled" : "active",
+    createdAt: String(record?.createdAt || fallback?.createdAt || new Date().toISOString()),
+    changedAt: record?.changedAt ? String(record.changedAt) : fallback?.changedAt,
+    lastLoginAt: record?.lastLoginAt ? String(record.lastLoginAt) : undefined,
+    mfa: {
+      ready: true,
+      enabled: Boolean(record?.mfa?.enabled),
+      required: Boolean(record?.mfa?.required),
+      method: record?.mfa?.method === "totp" ? "totp" : undefined,
+    },
+    passwordHash,
+  };
+}
+
+function publicAccount(record: AdminAccountRecord): AdminAccount {
+  const { passwordHash: _passwordHash, ...account } = record;
+  return account;
+}
+
+/**
+ * Authenticate against the encrypted durable admin registry. The Vercel
+ * bcrypt hash is a bootstrap owner credential only; it is never a plaintext
+ * fallback and is not used if the durable registry cannot be read. A first
+ * successful bootstrap login is represented as the owner account until the
+ * account-management endpoint persists it.
+ */
+export async function authenticateAdmin(req: NextRequest, email: string, password: string): Promise<AdminAccount | null> {
+  const suppliedEmail = String(email || "").trim().toLowerCase();
+  const suppliedPassword = String(password || "");
+  if (!suppliedEmail || !suppliedPassword || !authSecret()) return null;
+
+  const loaded = await readTelegramState(req);
+  if (!loaded.ok) return null;
+  const accounts = loaded.state.admin_accounts && typeof loaded.state.admin_accounts === "object"
+    ? loaded.state.admin_accounts as Record<string, any>
+    : {};
+  const stored = safeAccount(accounts[suppliedEmail], { email: suppliedEmail });
+  const legacyHash = suppliedEmail === configuredAdminEmail() ? String(loaded.state.admin_credentials?.passwordHash || "").trim() : "";
+  const bootstrapEmail = configuredAdminEmail();
+  const bootstrapHash = String(process.env.ROLAX_ADMIN_PASSWORD_HASH || "").trim();
+  const candidate = stored || (validHash(legacyHash)
+    ? safeAccount({ email: suppliedEmail, passwordHash: legacyHash, role: "owner", name: "ROLAX Owner", status: "active" }, { id: "admin_owner", createdAt: new Date().toISOString() })
+    : null) || (
+    suppliedEmail === bootstrapEmail && validHash(bootstrapHash)
+      ? safeAccount({ email: bootstrapEmail, passwordHash: bootstrapHash, role: "owner", name: "ROLAX Owner", status: "active" }, { id: "admin_owner", createdAt: new Date().toISOString() })
+      : null
+  );
+  if (!candidate || candidate.status !== "active" || candidate.mfa.required && !candidate.mfa.enabled) return null;
+  const matches = await bcrypt.compare(suppliedPassword, candidate.passwordHash).catch(() => false);
+  return matches ? publicAccount(candidate) : null;
+}
+
+/** Compatibility helper for existing route callers. */
+export async function verifyAdminCredentials(req: NextRequest | null, email: string, password: string) {
+  if (!req) return false;
+  return Boolean(await authenticateAdmin(req, email, password));
+}
+
+function sign(payload: object) {
+  const secret = authSecret();
+  if (!secret) return "";
+  return jwt.sign(payload, secret, { expiresIn: SESSION_TTL_SECONDS, algorithm: "HS256" });
+}
+
+function verify(token: string) {
+  const secret = authSecret();
+  if (!secret || !token) return null;
+  try { return jwt.verify(token, secret, { algorithms: ["HS256"] }) as JwtPayload; } catch { return null; }
+}
+
+export function issueAdminSession(response: NextResponse, account: Pick<AdminAccount, "email" | "role" | "mfa"> | string) {
+  const value = typeof account === "string"
+    ? { email: account.toLowerCase(), role: "owner" as AdminRole, mfa: { enabled: false } }
+    : account;
+  const token = sign({
+    sub: "admin",
+    email: value.email.toLowerCase(),
+    role: value.role,
+    authLevel: "password",
+    mfa: value.mfa.enabled ? "ready" : "not-enrolled",
+  });
+  if (!token) return false;
+  response.cookies.set(ADMIN_COOKIE, token, {
+    httpOnly: true,
+    secure: process.env.NODE_ENV === "production",
+    sameSite: "lax",
+    path: "/",
+    maxAge: SESSION_TTL_SECONDS,
+  });
+  return true;
+}
+
+export function issueUserSession(response: NextResponse, user: { id: string; email: string; name: string; isAdmin?: boolean }) {
+  const token = sign({
+    sub: "user",
+    id: String(user.id),
+    email: String(user.email).toLowerCase(),
+    name: String(user.name || "User"),
+    isAdmin: false,
+  });
+  if (!token) return false;
+  response.cookies.set(USER_COOKIE, token, {
+    httpOnly: true,
+    secure: process.env.NODE_ENV === "production",
+    sameSite: "lax",
+    path: "/",
+    maxAge: SESSION_TTL_SECONDS,
+  });
+  return true;
+}
+
+export function clearAuthCookies(response: NextResponse) {
+  for (const name of [ADMIN_COOKIE, USER_COOKIE]) {
+    response.cookies.set(name, "", { httpOnly: true, secure: process.env.NODE_ENV === "production", sameSite: "lax", path: "/", maxAge: 0 });
+  }
+}
+
+export function adminFromRequest(req: NextRequest): AdminClaims | null {
+  const payload = verify(req.cookies.get(ADMIN_COOKIE)?.value || "");
+  if (!payload || payload.sub !== "admin" || !payload.email || !validRole(payload.role)) return null;
+  if (payload.authLevel !== "password" || !["ready", "not-enrolled"].includes(String(payload.mfa))) return null;
+  return payload as AdminClaims;
+}
+
+export function adminHasRole(req: NextRequest, allowed: AdminRole[]) {
+  const admin = adminFromRequest(req);
+  return Boolean(admin && allowed.includes(admin.role));
+}
+
+/**
+ * Re-check the durable account registry for sensitive admin endpoints. JWTs
+ * remain short-lived for normal request authentication, while this helper
+ * makes disable/re-role changes effective without waiting for the cookie TTL.
+ */
+export async function activeAdminFromRequest(req: NextRequest): Promise<AdminClaims | null> {
+  const claims = adminFromRequest(req);
+  if (!claims) return null;
+  const loaded = await readTelegramState(req);
+  if (!loaded.ok) return null;
+  const accounts = loaded.state.admin_accounts && typeof loaded.state.admin_accounts === "object"
+    ? loaded.state.admin_accounts as Record<string, any>
+    : {};
+  const stored = safeAccount(accounts[claims.email], { email: claims.email, role: claims.role });
+  if (stored && stored.status === "active" && stored.role === claims.role) return claims;
+
+  // Bootstrap owner remains valid until an account record is explicitly
+  // created/disabled. It still requires a server-side bcrypt hash.
+  if (claims.email === configuredAdminEmail() && claims.role === "owner" && validHash(process.env.ROLAX_ADMIN_PASSWORD_HASH)) return claims;
+  const legacyHash = String(loaded.state.admin_credentials?.passwordHash || "").trim();
+  if (claims.email === configuredAdminEmail() && claims.role === "owner" && validHash(legacyHash)) return claims;
+  return null;
+}
+
+export async function activeAdminHasRole(req: NextRequest, allowed: AdminRole[]) {
+  const admin = await activeAdminFromRequest(req);
+  return Boolean(admin && allowed.includes(admin.role));
+}
+
+export function userFromRequest(req: NextRequest): UserClaims | AdminClaims | null {
+  const admin = adminFromRequest(req);
+  if (admin) return admin;
+  const payload = verify(req.cookies.get(USER_COOKIE)?.value || "");
+  if (!payload || payload.sub !== "user" || payload.isAdmin !== false || !payload.email || !payload.id) return null;
+  return payload as UserClaims;
+}
+
+export function adminOnly(req: NextRequest) {
+  return adminFromRequest(req);
+}
+
+export function sameOrigin(req: NextRequest) {
+  const origin = req.headers.get("origin");
+  if (!origin) return true;
+  try {
+    const parsed = new URL(origin);
+    const host = req.headers.get("x-forwarded-host") || req.headers.get("host") || req.nextUrl.host;
+    const proto = req.headers.get("x-forwarded-proto") || req.nextUrl.protocol.replace(":", "") || "https";
+    return parsed.host === host && parsed.protocol === `${proto}:`;
+  } catch { return false; }
+}
+
+export function unauthorized(message = "Authentication required") {
+  return NextResponse.json({ ok: false, error: message }, { status: 401, headers: { "cache-control": "no-store" } });
+}
+
+export function forbidden(message = "Admin access required") {
+  return NextResponse.json({ ok: false, error: message }, { status: 403, headers: { "cache-control": "no-store" } });
+}
+
+export { publicAccount, safeAccount, type AdminAccountRecord };
