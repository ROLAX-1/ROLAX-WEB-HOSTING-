+++ b/app/api/admin/password/route.ts
@@ -0,0 +1,136 @@
+import "server-only";
+import { NextRequest, NextResponse } from "next/server";
+import bcrypt from "bcryptjs";
+import { randomUUID } from "node:crypto";
+import {
+  ADMIN_PASSWORD_MIN_LENGTH,
+  activeAdminFromRequest,
+  activeAdminHasRole,
+  authenticateAdmin,
+  clearAuthCookies,
+  forbidden,
+  sameOrigin,
+  unauthorized,
+} from "@/lib/server-auth";
+import { readTelegramState, writeTelegramState } from "@/lib/telegram-state";
+import { rateLimit } from "@/lib/rate-limit";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const attempts = new Map<string, { count: number; resetAt: number }>();
+
+function clientKey(req: NextRequest) {
+  return String(req.headers.get("x-forwarded-for") || req.headers.get("x-real-ip") || "unknown")
+    .split(",")[0].trim().slice(0, 100);
+}
+
+function rateLimited(req: NextRequest) {
+  const now = Date.now();
+  const key = clientKey(req);
+  const current = attempts.get(key);
+  if (!current || current.resetAt <= now) {
+    attempts.set(key, { count: 1, resetAt: now + 15 * 60 * 1000 });
+    return false;
+  }
+  current.count += 1;
+  return current.count > 5;
+}
+
+function passwordPolicy(password: string) {
+  if (password.length < ADMIN_PASSWORD_MIN_LENGTH) return "Password must be at least 16 characters";
+  if (password.length > 256) return "Password is too long";
+  if (/\s/.test(password)) return "Password cannot contain spaces or line breaks";
+  if (!/[a-z]/.test(password) || !/[A-Z]/.test(password) || !/[0-9]/.test(password) || !/[^A-Za-z0-9]/.test(password)) {
+    return "Use uppercase, lowercase, number, and symbol";
+  }
+  return "";
+}
+
+export async function POST(req: NextRequest) {
+  const admin = await activeAdminFromRequest(req);
+  if (!admin) return unauthorized("Admin session required");
+  if (!(await activeAdminHasRole(req, ["owner", "security_admin"]))) return forbidden("Security-admin role required");
+  if (!sameOrigin(req)) return NextResponse.json({ ok: false, error: "Invalid request origin" }, { status: 403 });
+  const globalLimit = rateLimit(req, "admin-password", 5, 15 * 60 * 1000);
+  if (globalLimit.limited || rateLimited(req)) {
+    return NextResponse.json(
+      { ok: false, error: "Too many password-change attempts. Try again later." },
+      { status: 429, headers: { "cache-control": "no-store", "retry-after": "900" } },
+    );
+  }
+
+  let body: any = {};
+  try { body = await req.json(); } catch {
+    return NextResponse.json({ ok: false, error: "Invalid JSON" }, { status: 400, headers: { "cache-control": "no-store" } });
+  }
+
+  const currentPassword = String(body.currentPassword || "");
+  const newPassword = String(body.newPassword || "");
+  const confirmPassword = String(body.confirmPassword || "");
+  if (!currentPassword || !newPassword || !confirmPassword) {
+    return NextResponse.json({ ok: false, error: "All password fields are required" }, { status: 400, headers: { "cache-control": "no-store" } });
+  }
+  if (newPassword !== confirmPassword) {
+    return NextResponse.json({ ok: false, error: "New passwords do not match" }, { status: 400, headers: { "cache-control": "no-store" } });
+  }
+  const policyError = passwordPolicy(newPassword);
+  if (policyError) return NextResponse.json({ ok: false, error: policyError }, { status: 400, headers: { "cache-control": "no-store" } });
+  if (newPassword === currentPassword) {
+    return NextResponse.json({ ok: false, error: "Choose a different password" }, { status: 400, headers: { "cache-control": "no-store" } });
+  }
+
+  const currentValid = await authenticateAdmin(req, admin.email, currentPassword);
+  if (!currentValid) return NextResponse.json({ ok: false, error: "Current password is incorrect" }, { status: 401, headers: { "cache-control": "no-store" } });
+
+  const loaded = await readTelegramState(req);
+  if (!loaded.ok) {
+    return NextResponse.json(
+      { ok: false, error: "Secure password storage is temporarily unavailable. No change was made." },
+      { status: 503, headers: { "cache-control": "no-store" } },
+    );
+  }
+
+  const passwordHash = await bcrypt.hash(newPassword, 12);
+  const now = new Date().toISOString();
+  const accounts = loaded.state.admin_accounts && typeof loaded.state.admin_accounts === "object"
+    ? { ...loaded.state.admin_accounts }
+    : {};
+  const current = accounts[admin.email];
+  accounts[admin.email] = {
+    id: String(current?.id || `admin_${admin.email}`).slice(0, 120),
+    email: admin.email,
+    name: String(current?.name || "ROLAX Admin").slice(0, 120),
+    role: admin.role,
+    status: "active",
+    passwordHash,
+    createdAt: String(current?.createdAt || now),
+    changedAt: now,
+    lastLoginAt: current?.lastLoginAt,
+    mfa: { enabled: Boolean(current?.mfa?.enabled), required: Boolean(current?.mfa?.required), method: current?.mfa?.method === "totp" ? "totp" : undefined },
+  };
+  const audit = Array.isArray(loaded.state.audit_events) ? loaded.state.audit_events : [];
+  const saved = await writeTelegramState(
+    req,
+    {
+      ...loaded.state,
+      admin_accounts: accounts,
+      admin_credentials: undefined,
+      audit_events: [...audit.slice(-99), { id: randomUUID(), actor: admin.email, action: "admin.password.rotate", at: now }],
+    },
+    loaded.webhookUrl,
+  );
+  if (!saved.ok) {
+    return NextResponse.json(
+      { ok: false, error: "Secure password storage failed. No change was confirmed." },
+      { status: 503, headers: { "cache-control": "no-store" } },
+    );
+  }
+
+  const response = NextResponse.json(
+    { ok: true, passwordChanged: true, reauthenticate: true },
+    { headers: { "cache-control": "no-store" } },
+  );
+  clearAuthCookies(response);
+  return response;
+}
