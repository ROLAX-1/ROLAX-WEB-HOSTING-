@@ -0,0 +1,125 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useRouter } from "next/navigation";
+import { toast } from "@/components/ui/Toaster";
+
+type Account = { id: string; email: string; name: string; role: string; status: string; mfa?: { ready?: boolean; enabled?: boolean; required?: boolean } };
+
+export default function SecurityPanel({ role = "auditor" }: { role?: string }) {
+  const router = useRouter();
+  const [currentPassword, setCurrentPassword] = useState("");
+  const [newPassword, setNewPassword] = useState("");
+  const [confirmPassword, setConfirmPassword] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [accounts, setAccounts] = useState<Account[]>([]);
+  const [accountBusy, setAccountBusy] = useState(false);
+  const [newAdmin, setNewAdmin] = useState({ name: "", email: "", role: "operator", password: "" });
+
+  async function loadAccounts() {
+    if (!['owner', 'security_admin'].includes(role)) return;
+    const response = await fetch("/api/admin/accounts", { cache: "no-store" });
+    const result = await response.json().catch(() => ({}));
+    if (!response.ok || !result?.ok) throw new Error(result?.error || "Admin accounts unavailable");
+    setAccounts(Array.isArray(result.accounts) ? result.accounts : []);
+  }
+
+  useEffect(() => { loadAccounts().catch(() => {}); }, [role]);
+
+  async function changePassword(event: React.FormEvent) {
+    event.preventDefault();
+    setBusy(true);
+    try {
+      const response = await fetch("/api/admin/password", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ currentPassword, newPassword, confirmPassword }),
+        cache: "no-store",
+      });
+      const result = await response.json().catch(() => ({}));
+      if (!response.ok || !result?.ok) throw new Error(result?.error || "Password change failed");
+      setCurrentPassword(""); setNewPassword(""); setConfirmPassword("");
+      toast("Password changed. Please sign in again.", "success");
+      window.setTimeout(() => router.replace("/login"), 700);
+    } catch (error: any) {
+      toast(String(error?.message || "Password change failed"), "error");
+    } finally { setBusy(false); }
+  }
+
+  async function createAccount(event: React.FormEvent) {
+    event.preventDefault();
+    setAccountBusy(true);
+    try {
+      const response = await fetch("/api/admin/accounts", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(newAdmin), cache: "no-store" });
+      const result = await response.json().catch(() => ({}));
+      if (!response.ok || !result?.ok) throw new Error(result?.error || "Account creation failed");
+      setNewAdmin({ name: "", email: "", role: "operator", password: "" });
+      await loadAccounts();
+      toast("Separate admin account created.", "success");
+    } catch (error: any) { toast(String(error?.message || "Account creation failed"), "error"); }
+    finally { setAccountBusy(false); }
+  }
+
+  async function updateAccount(account: Account) {
+    setAccountBusy(true);
+    try {
+      const response = await fetch("/api/admin/accounts", { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ email: account.email, status: account.status === "active" ? "disabled" : "active" }), cache: "no-store" });
+      const result = await response.json().catch(() => ({}));
+      if (!response.ok || !result?.ok) throw new Error(result?.error || "Account update failed");
+      await loadAccounts();
+      toast("Account status updated.", "success");
+    } catch (error: any) { toast(String(error?.message || "Account update failed"), "error"); }
+    finally { setAccountBusy(false); }
+  }
+
+  return (
+    <div className="max-w-3xl space-y-6">
+      <div>
+        <h2 className="font-grotesk text-xl font-bold">Security & Admin Accounts</h2>
+        <p className="text-xs text-[#888] mt-1">Passwords are validated server-side, stored only as bcrypt hashes, and never returned to the browser.</p>
+      </div>
+      {['owner', 'security_admin'].includes(role) && (
+        <div className="rounded-2xl bg-[#111] border border-[#222] p-5">
+          <h3 className="text-sm font-semibold">Rotate your password</h3>
+          <form onSubmit={changePassword} className="mt-4 space-y-4">
+            <input type="password" autoComplete="current-password" placeholder="Current password" value={currentPassword} onChange={e => setCurrentPassword(e.target.value)} required className="w-full px-4 py-3 rounded-xl bg-black border border-[#222] text-sm" />
+            <input type="password" autoComplete="new-password" minLength={16} placeholder="New password" value={newPassword} onChange={e => setNewPassword(e.target.value)} required className="w-full px-4 py-3 rounded-xl bg-black border border-[#222] text-sm" />
+            <input type="password" autoComplete="new-password" minLength={16} placeholder="Confirm new password" value={confirmPassword} onChange={e => setConfirmPassword(e.target.value)} required className="w-full px-4 py-3 rounded-xl bg-black border border-[#222] text-sm" />
+            <p className="text-[11px] text-[#666]">Minimum 16 characters with uppercase, lowercase, number, and symbol. Re-authentication is required after rotation.</p>
+            <button type="submit" disabled={busy} className="px-5 py-2.5 rounded-full bg-white text-black text-sm font-medium disabled:opacity-50">{busy ? "Changing..." : "Change password"}</button>
+          </form>
+        </div>
+      )}
+      {role === "owner" && (
+        <div className="rounded-2xl bg-[#111] border border-[#222] p-5">
+          <h3 className="text-sm font-semibold">Create a separate admin account</h3>
+          <p className="text-[11px] text-[#666] mt-1">No shared credentials. Owner approval is required; each account has one explicit role.</p>
+          <form onSubmit={createAccount} className="mt-4 grid md:grid-cols-2 gap-3">
+            <input value={newAdmin.name} onChange={e => setNewAdmin({ ...newAdmin, name: e.target.value })} placeholder="Full name" required className="px-3 py-2.5 rounded-xl bg-black border border-[#222] text-sm" />
+            <input type="email" value={newAdmin.email} onChange={e => setNewAdmin({ ...newAdmin, email: e.target.value })} placeholder="admin@example.com" required className="px-3 py-2.5 rounded-xl bg-black border border-[#222] text-sm" />
+            <select value={newAdmin.role} onChange={e => setNewAdmin({ ...newAdmin, role: e.target.value })} className="px-3 py-2.5 rounded-xl bg-black border border-[#222] text-sm"><option value="security_admin">Security admin</option><option value="operator">Operator</option><option value="support">Support</option><option value="auditor">Auditor</option></select>
+            <input type="password" minLength={16} autoComplete="new-password" value={newAdmin.password} onChange={e => setNewAdmin({ ...newAdmin, password: e.target.value })} placeholder="Temporary password (16+ chars)" required className="px-3 py-2.5 rounded-xl bg-black border border-[#222] text-sm" />
+            <button type="submit" disabled={accountBusy} className="md:col-span-2 px-5 py-2.5 rounded-full bg-white text-black text-sm font-medium disabled:opacity-50">{accountBusy ? "Saving..." : "Create account"}</button>
+          </form>
+        </div>
+      )}
+      {['owner', 'security_admin'].includes(role) && (
+        <div className="rounded-2xl bg-[#111] border border-[#222] p-5">
+          <h3 className="text-sm font-semibold">Admin accounts</h3>
+          <div className="mt-3 space-y-2">
+            {accounts.map(account => (
+              <div key={account.id} className="flex flex-wrap items-center gap-2 rounded-xl bg-black border border-[#222] px-3 py-2 text-xs">
+                <span className="flex-1 min-w-[180px]"><b>{account.name}</b> <span className="text-[#777]">{account.email}</span></span>
+                <span className="px-2 py-1 rounded-full bg-[#222] text-[#aaa]">{account.role}</span>
+                <span className={account.status === "active" ? "text-[#00ff88]" : "text-red-300"}>{account.status}</span>
+                <span className="text-[#777]">MFA {account.mfa?.enabled ? "ready" : "not enrolled"}</span>
+                {role === "owner" && account.role !== "owner" && <button disabled={accountBusy} onClick={() => updateAccount(account)} className="px-2 py-1 rounded-full bg-[#222] text-[10px]">{account.status === "active" ? "Disable" : "Enable"}</button>}
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+      <div className="rounded-2xl bg-yellow-500/5 border border-yellow-500/20 p-4 text-xs text-yellow-100/80">MFA enrollment is modeled as a server-side account field and session assurance level; wire a TOTP/WebAuthn provider before marking an account MFA-required.</div>
+    </div>
+  );
+}
