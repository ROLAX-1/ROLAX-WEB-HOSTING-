new file mode 100644
index 0000000..cc9578f
--- /dev/null
+++ b/lib/python-policy.ts
@@ -0,0 +1,68 @@
+import "server-only";
+import { createHash } from "node:crypto";
+
+export type PythonSourceFile = { name: string; content: string };
+
+export type PythonExecutionDecision = {
+  allowed: boolean;
+  fingerprint: string;
+  reason: "not-python" | "trusted-hash" | "blocked";
+};
+
+function normalizedName(name: unknown) {
+  return String(name || "")
+    .replace(/\\/g, "/")
+    .split("/")
+    .filter(part => part && part !== "." && part !== "..")
+    .join("/")
+    .slice(0, 240);
+}
+
+function isPython(files: PythonSourceFile[]) {
+  return files.some(file => /\.py$/i.test(normalizedName(file.name)));
+}
+
+/**
+ * Produce a deterministic approval identifier for the complete project, not
+ * just its entry file. This prevents an approved entry point from importing a
+ * newly uploaded, unreviewed helper module.
+ */
+export function pythonProjectFingerprint(files: PythonSourceFile[]) {
+  const hash = createHash("sha256");
+  files
+    .map(file => ({ name: normalizedName(file.name), content: String(file.content || "") }))
+    .sort((a, b) => a.name.localeCompare(b.name))
+    .forEach(file => {
+      hash.update(file.name, "utf8");
+      hash.update("\0", "utf8");
+      hash.update(file.content, "utf8");
+      hash.update("\0", "utf8");
+    });
+  return hash.digest("hex");
+}
+
+function configuredHashes() {
+  return new Set(
+    String(process.env.ROLAX_TRUSTED_PYTHON_SHA256 || "")
+      .split(/[\s,]+/)
+      .map(value => value.trim().toLowerCase())
+      .filter(value => /^[a-f0-9]{64}$/.test(value)),
+  );
+}
+
+/**
+ * Python uploaded by a user is blocked by default. The only temporary escape
+ * hatch is an operator-approved, full-project SHA-256 configured server-side
+ * in ROLAX_TRUSTED_PYTHON_SHA256. This is deliberately not controllable by a
+ * request field, browser state, source file, or admin UI.
+ */
+export function pythonExecutionDecision(files: PythonSourceFile[]): PythonExecutionDecision {
+  if (!isPython(files)) return { allowed: true, fingerprint: "", reason: "not-python" };
+  const fingerprint = pythonProjectFingerprint(files);
+  const allowed = configuredHashes().has(fingerprint);
+  return { allowed, fingerprint, reason: allowed ? "trusted-hash" : "blocked" };
+}
+
+export function pythonExecutionMessage(fingerprint: string) {
+  return `Python execution is disabled until this project is isolated or explicitly approved. Project fingerprint: ${fingerprint}`;
+}
